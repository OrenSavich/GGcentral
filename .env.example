# Local development placeholders. Copy to .env and keep .env untracked.
# These values are not production credentials.

NODE_ENV=development

POSTGRES_USER=ggcentral
POSTGRES_PASSWORD=ggcentral_local_only
POSTGRES_DB=ggcentral
POSTGRES_PORT=5432

# Used by the API on the host. Docker Compose rewrites the host to the postgres service.
DATABASE_URL=postgresql://ggcentral:ggcentral_local_only@localhost:5432/ggcentral

API_PORT=3001
WEB_PORT=3000
WEB_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3001
LOG_LEVEL=info
