# Production environment for the Oracle host.
# Install it as /home/ubuntu/ggcentral/.env with mode 600.
# GitHub Actions updates IMAGE_TAG. It does not replace this file.
# These placeholders are not production credentials.

POSTGRES_USER=ggcentral
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=ggcentral

API_IMAGE=ghcr.io/orensavich/ggcentral-api
WEB_IMAGE=ghcr.io/orensavich/ggcentral-web
IMAGE_TAG=latest

# Browser origin allowed by API CORS. Use http://YOUR_SERVER_IP until a domain exists.
WEB_ORIGIN=http://YOUR_SERVER_IP
LOG_LEVEL=info
